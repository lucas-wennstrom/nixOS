{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " → "
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "┌────────────────── \u001b[1;36mSystem\u001b[0m ───────────────────┐"
    },
    {
      "type": "os",
      "key": "  OS"
    },
    {
      "type": "kernel",
      "key": "  Kernel"
    },
    {
      "type": "packages",
      "key": "  Packages"
    },
    {
      "type": "shell",
      "key": "  Shell"
    },
    {
      "type": "wm",
      "key": "  WM"
    },
    {
      "type": "terminal",
      "key": "  Term"
    },
    {
      "type": "custom",
      "format": "├────────────────── \u001b[1;36mHardware\u001b[0m ─────────────────┤"
    },
    {
      "type": "host",
      "key": "  Host"
    },
    {
      "type": "cpu",
      "key": "  CPU"
    },
    {
      "type": "gpu",
      "key": "  GPU"
    },
    {
      "type": "memory",
      "key": "  Memory"
    },
    {
      "type": "disk",
      "key": "  Disk"
    },
    {
      "type": "battery",
      "key": "  Battery"
    },
    {
      "type": "custom",
      "format": "├────────────────── \u001b[1;36mSession\u001b[0m ──────────────────┤"
    },
    {
      "type": "uptime",
      "key": "  Uptime"
    },
    {
      "type": "localip",
      "key": "  Local IP"
    },
    {
      "type": "custom",
      "format": "└─────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
